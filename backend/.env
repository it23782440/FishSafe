# ============================================================
#  FishSafe backend environment variables
#  Copy to ".env" for local dev; set the same keys in Render.
#  NEVER commit the real .env file.
# ============================================================

# Server port (Render provides PORT automatically; keep 5000 for local dev)
PORT=5000

# Node environment
NODE_ENV=development

# MongoDB Atlas connection string.
# Create a free cluster at https://cloud.mongodb.com, then:
#   Database Access -> add user;  Network Access -> allow 0.0.0.0/0 (or Render IPs)
#   Connect -> Drivers -> copy the SRV string and put the password in.
MONGODB_URI=mongodb+srv://lukshanmaduwantha2002_db_user:QK0dfiPogIQMAeWm@cluster0.dqpzohs.mongodb.net/

# Shared secret the ESP32 must send in the "x-api-key" header on POST /api/sensors/data.
# Use a long random string. Must equal API_KEY in the ESP32 firmware.
DEVICE_API_KEY=CHANGE_ME_SUPER_SECRET_KEY

# Comma-separated list of allowed browser origins (your Vercel URLs).
# Example: https://fishsafe.vercel.app,https://fishsafe-git-main-you.vercel.app
# Use * only for quick local testing.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long (seconds) before a device with no new data is considered OFFLINE.
DEVICE_OFFLINE_SECONDS=180
